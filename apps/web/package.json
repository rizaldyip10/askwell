{
  "name": "@askwell/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:widget && next dev",
    "build": "pnpm build:widget && next build",
    "build:widget": "pnpm --filter @askwell/widget build && node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').copyFileSync('../widget/dist/widget.js','public/widget.js')\"",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@askwell/db": "workspace:*",
    "@askwell/shared": "workspace:*",
    "@clerk/nextjs": "7.9.23",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@askwell/widget": "workspace:*",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
