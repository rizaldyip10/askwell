# Copy to .env.local and fill in. Never commit real values.

# Supabase (dev project for local + previews; prod project for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Clerk (auth + billing)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenAI
OPENAI_API_KEY=

# Arcjet
ARCJET_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# App
NEXT_PUBLIC_APP_URL=
LANDING_WIDGET_KEY=

# Dev tooling (not used by the app)
# `pnpm db:types` regenerates packages/db/types.ts from the dev project.
# It reads these from the shell environment, not from .env.local: export both in your
# shell before running it (e.g. `export SUPABASE_PROJECT_REF=...`).
# SUPABASE_ACCESS_TOKEN: a scoped personal access token (read access to the dev project).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
